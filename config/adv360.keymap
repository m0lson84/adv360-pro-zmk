#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
        };

        ls: layer_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_SHIFT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
        };
    };

    macros {
        launcher: launcher {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "LAUNCHER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1       &kp N2      &kp N3      &kp N4     &kp N5  &kp MINUS                                                                    &kp EQUAL          &kp N6  &kp N7  &kp N8          &kp N9        &kp N0          &kp INS
&kp TAB    &kp Q        &kp W       &kp E       &kp R      &kp T   &none                                                                        &none              &kp Y   &kp U   &kp I           &kp O         &kp P           &kp BSLH
&kp ESC    &kp A        &kp S       &kp D       &kp F      &kp G   &kp LS(LA(LC(LGUI)))  &launcher  &kp LA(TAB)      &kp C_NEXT  &kp C_PP       &kp LS(LA(LCTRL))  &kp H   &kp J   &kp K           &kp L         &kp SEMI        &kp SQT
&kp LSHFT  &hm LCTRL Z  &hm LALT X  &hm LGUI C  &kp V      &kp B                                    &kp LCTRL        &kp RCTRL                                     &kp N   &kp M   &hm RGUI COMMA  &hm RALT DOT  &hm RCTRL FSLH  &kp RSHFT
&mo 1      &none        &none       &kp LEFT    &kp RIGHT          &ls 1 SPACE           &kp DEL    &kp LGUI         &kp RGUI    &kp BACKSPACE  &ls 2 ENTER                &kp UP  &kp DOWN        &kp LBKT      &kp RBKT        &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp F1  &kp F2     &kp F3     &kp F4    &kp F5           &kp F6     &trans                                      &trans  &kp F7     &kp F8     &kp F9     &kp F10       &kp F11          &kp F12
&trans  &kp EXCL   &kp AT     &kp LBRC  &kp RIGHT_BRACE  &kp PIPE   &trans                                      &trans  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &kp KP_SLASH     &trans
&trans  &kp HASH   &kp DLLR   &kp LPAR  &kp RPAR         &kp GRAVE  &trans  &trans  &trans      &trans  &trans  &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &kp KP_MULTIPLY  &trans
&trans  &kp PRCNT  &kp CARET  &kp LBKT  &kp RBKT         &kp TILDE                  &trans      &trans                  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT    &kp KP_EQUAL     &trans
&trans  &trans     &trans     &trans    &trans                      &trans  &trans  &trans      &trans  &trans  &trans             &kp KP_N0  &trans     &trans        &trans           &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp C_BRI_DN   &kp C_BRI_UP   &kp LC(UP)     &kp LC(SPACE)  &bl BL_DEC     &bl BL_INC     &bootloader                                      &bootloader  &kp C_PREV       &kp C_PP        &kp C_NEXT    &kp C_MUTE       &kp C_VOL_DN  &kp C_VOL_UP
&trans         &kp LC(Q)      &trans         &kp LC(LS(E))  &trans         &kp LC(T)      &trans                                           &trans       &kp HOME         &kp PG_DN       &kp PG_UP     &kp END          &trans        &trans
&trans         &kp LS(LC(A))  &kp LS(LC(S))  &trans         &trans         &kp LS(LC(G))  &trans       &trans  &trans      &trans  &trans  &trans       &kp LEFT_ARROW   &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans        &trans
&kp LS(LC(Z))  &kp LC(Z)      &kp LS(LC(X))  &kp LS(LC(C))  &kp LS(LC(V))  &trans                              &trans      &trans                       &kp LS(LC(TAB))  &kp LC(TAB)     &kp LG(LBKT)  &kp LG(RBKT)     &trans        &trans
&trans         &trans         &trans         &trans         &trans                        &trans       &trans  &trans      &trans  &trans  &trans                        &trans          &trans        &trans           &trans        &trans
            >;
        };
    };
};
